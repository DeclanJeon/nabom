{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NABOM CanonicalReflection (user-facing)",
  "type": "object",
  "required": ["reflection_id", "mode", "resolver_version", "situation", "observation_focus", "caution_signals", "recommended_action", "evidence_refs"],
  "properties": {
    "reflection_id": { "type": "string" },
    "mode": { "const": "record_reflection" },
    "resolver_version": { "type": "string" },
    "resolver_input_hash": { "type": "string" },
    "situation": {
      "type": "object",
      "required": ["confidence"],
      "properties": {
        "code": { "type": "string" },
        "label_ko": { "type": "string" },
        "theme_topic": { "type": "string" },
        "theme_lens": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "observation_focus": { "type": "array", "items": { "type": "string" } },
    "caution_signals": { "type": "array", "items": { "type": "string" } },
    "recommended_action": {
      "type": "object",
      "required": ["title", "instruction", "success_condition", "reversible"],
      "properties": {
        "title": { "type": "string" },
        "instruction": { "type": "string" },
        "success_condition": { "type": "string" },
        "reversible": { "type": "boolean" }
      }
    },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "request_id": { "type": "string" }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false
}
